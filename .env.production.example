# LearnHouse production configuration template
# Replace every <...> value before starting the container.

LEARNHOUSE_ENV=production
NEXT_PUBLIC_LEARNHOUSE_ENV=production
LEARNHOUSE_DEVELOPMENT_MODE=False
LEARNHOUSE_LOGFIRE_ENABLED=False

# Public HTTPS endpoints
LEARNHOUSE_DOMAIN=learn.school.example
LEARNHOUSE_FRONTEND_DOMAIN=learn.school.example
LEARNHOUSE_SSL=True
LEARNHOUSE_TENANCY=single
LEARNHOUSE_PORT=9000
NEXT_PUBLIC_LEARNHOUSE_API_URL=https://learn.school.example/api/v1/
NEXT_PUBLIC_LEARNHOUSE_BACKEND_URL=https://learn.school.example/
NEXT_PUBLIC_LEARNHOUSE_DOMAIN=learn.school.example
NEXT_PUBLIC_LEARNHOUSE_TOP_DOMAIN=school.example
NEXT_PUBLIC_LEARNHOUSE_MULTI_ORG=False
NEXT_PUBLIC_LEARNHOUSE_DEFAULT_ORG=default
NEXT_PUBLIC_LEARNHOUSE_HTTPS=True
NEXTAUTH_URL=https://learn.school.example
NEXT_PUBLIC_COLLAB_URL=wss://learn.school.example/collab

# Generate independent random values of at least 32 characters.
LEARNHOUSE_AUTH_JWT_SECRET_KEY=<generate-a-random-jwt-secret>
NEXTAUTH_SECRET=<generate-a-random-nextauth-secret>
COLLAB_INTERNAL_KEY=<generate-a-random-collab-secret>

# PostgreSQL and Redis
POSTGRES_USER=learnhouse
POSTGRES_PASSWORD=<generate-a-random-database-password>
POSTGRES_DB=learnhouse
LEARNHOUSE_SQL_CONNECTION_STRING=postgresql://learnhouse:<database-password>@db:5432/learnhouse
LEARNHOUSE_REDIS_CONNECTION_STRING=redis://redis:6379/learnhouse
LEARNHOUSE_REDIS_URL=redis://redis:6379

# Leave blank for fresh/versioned databases. A legacy unversioned database must
# use a revision verified from the exact image that created its current schema.
LEARNHOUSE_ALEMBIC_BASELINE=

# Initial administrator values are one-time bootstrap inputs only. Keep the
# bootstrap flag False and omit the password after installation.
LEARNHOUSE_BOOTSTRAP_ADMIN=False
# LEARNHOUSE_INITIAL_ADMIN_EMAIL=admin@school.example
# LEARNHOUSE_INITIAL_ADMIN_PASSWORD=<one-time-strong-password>
LEARNHOUSE_INITIAL_ORG_NAME=School Learning Platform
LEARNHOUSE_INITIAL_ORG_SLUG=default

# OpenAI-compatible AI
LEARNHOUSE_IS_AI_ENABLED=True
LEARNHOUSE_AI_PROVIDER=openai_compatible
LEARNHOUSE_OPENAI_BASE_URL=https://api.provider.example/v1
LEARNHOUSE_OPENAI_API_KEY=<provider-api-key>
LEARNHOUSE_OPENAI_MODEL=<text-model>
LEARNHOUSE_OPENAI_IMAGE_MODEL=<image-model>

# Embeddings, configured independently of chat. Many OpenAI-compatible
# providers serve /chat/completions but return 404 on /embeddings, which used
# to degrade RAG to a meaningless lexical hash without anyone noticing.
# Leave LEARNHOUSE_EMBEDDING_BASE_URL pointing at the bundled `embeddings`
# service unless your provider genuinely serves embeddings.
LEARNHOUSE_EMBEDDING_BASE_URL=http://embeddings:7997/v1
LEARNHOUSE_EMBEDDING_API_KEY=
LEARNHOUSE_OPENAI_EMBEDDING_MODEL=jinaai/jina-embeddings-v2-base-zh
# Last-resort lexical-hash fallback. Off by default: when the embedding
# backend is down, RAG requests fail loudly instead of returning results that
# look plausible but are not semantic. Set to true only if keyword-grade
# retrieval is better than an error for your deployment.
LEARNHOUSE_EMBEDDING_ALLOW_HASH_FALLBACK=false
# Container guardrails for the bundled CPU model. Do not lower these without
# measuring cold-start and inference memory for the selected model.
EMBEDDINGS_MEMORY_RESERVATION=4g
EMBEDDINGS_MEMORY_LIMIT=5g

# Persistent content storage. Filesystem is acceptable for a single-node pilot
# only when the named Docker volume has a tested off-host backup.
LEARNHOUSE_CONTENT_DELIVERY_TYPE=filesystem

# Recommended production integrations
LEARNHOUSE_SENTRY_DSN=
LEARNHOUSE_EMAIL_PROVIDER=smtp
LEARNHOUSE_SYSTEM_EMAIL_ADDRESS=learnhouse@school.example
LEARNHOUSE_SMTP_HOST=<smtp-host>
LEARNHOUSE_SMTP_PORT=587
LEARNHOUSE_SMTP_USERNAME=<smtp-username>
LEARNHOUSE_SMTP_PASSWORD=<smtp-password>
# Preferred for production: mount a 0600 file and leave the plaintext variable empty.
LEARNHOUSE_SMTP_PASSWORD_FILE=/run/secrets/learnhouse_smtp_password
LEARNHOUSE_SMTP_USE_TLS=True

# Code execution sandbox (Judge0-compatible API).
# Default: the bundled self-hosted executor service from docker-compose.yml.
# Keep production pointed at the bundled service. The former external Judge0
# failed the pilot's Chinese-source and Node runtime gates and is not a safe
# fallback without reproducing those guarantees first.
LEARNHOUSE_JUDGE0_API_URL=http://executor:2358
LEARNHOUSE_JUDGE0_CLIENT_ID=
LEARNHOUSE_JUDGE0_CLIENT_SECRET=
