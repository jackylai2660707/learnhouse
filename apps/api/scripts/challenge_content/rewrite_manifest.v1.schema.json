{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://learnhouse.local/schemas/challenge-content-rewrite-manifest-v1.json",
  "title": "LearnHouse deterministic challenge content rewrite manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "inventory", "rewrites"],
  "properties": {
    "schema_version": {"const": 1},
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "languages"],
      "properties": {
        "total": {"const": 51},
        "languages": {
          "type": "object",
          "additionalProperties": false,
          "required": ["63", "71"],
          "properties": {
            "63": {"const": 40},
            "71": {"const": 11}
          }
        }
      }
    },
    "rewrites": {
      "type": "array",
      "minItems": 51,
      "maxItems": 51,
      "items": {"$ref": "#/$defs/rewriteEntry"}
    }
  },
  "$defs": {
    "rewriteEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "source_fingerprint", "rewrite"],
      "properties": {
        "identity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["course_uuid", "activity_uuid", "challenge_uuid", "block_id", "language_id"],
          "properties": {
            "course_uuid": {"type": "string", "minLength": 1},
            "activity_uuid": {"type": "string", "minLength": 1},
            "challenge_uuid": {"type": "string", "minLength": 1},
            "block_id": {"type": "string", "minLength": 1},
            "language_id": {"enum": [63, 71]}
          }
        },
        "source_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "rewrite": {
          "type": "object",
          "additionalProperties": false,
          "required": ["title", "description", "starter_code", "solution_code", "hints", "difficulty", "tests"],
          "properties": {
            "title": {"type": "string", "minLength": 1},
            "description": {
              "type": "string",
              "minLength": 1,
              "allOf": [
                {"pattern": "(?:輸入|[Ii]nput)\\s*[：:]"},
                {"pattern": "(?:輸出|[Oo]utput)\\s*[：:]"}
              ]
            },
            "starter_code": {"type": "string", "minLength": 1},
            "solution_code": {"type": "string", "minLength": 1},
            "hints": {"type": "array", "items": {"type": "string", "minLength": 1}},
            "difficulty": {"type": "string", "minLength": 1},
            "tests": {
              "type": "array",
              "minItems": 3,
              "maxItems": 50,
              "items": {"$ref": "#/$defs/testCase"},
              "allOf": [
                {
                  "contains": {
                    "type": "object",
                    "properties": {"visibility": {"const": "visible"}},
                    "required": ["visibility"]
                  },
                  "minContains": 1
                },
                {
                  "contains": {
                    "type": "object",
                    "properties": {"visibility": {"const": "hidden"}},
                    "required": ["visibility"]
                  },
                  "minContains": 2
                }
              ]
            }
          }
        }
      }
    },
    "testCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["test_uuid", "label", "stdin", "expected_stdout", "visibility", "order"],
      "properties": {
        "test_uuid": {"type": "string", "minLength": 1},
        "label": {"type": "string", "minLength": 1},
        "stdin": {"type": "string", "minLength": 1},
        "expected_stdout": {"type": "string"},
        "visibility": {"enum": ["visible", "hidden"]},
        "order": {"type": "integer", "minimum": 0}
      }
    }
  }
}
