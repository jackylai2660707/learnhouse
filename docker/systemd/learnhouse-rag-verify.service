[Unit]
Description=Verify LearnHouse RAG embeddings and vector index (read-only)
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=root
Group=root
Environment="PATH=/root/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin"
WorkingDirectory=/opt/1panel/docker/compose/learnhouse
EnvironmentFile=-/etc/learnhouse/rag-verify.env
ExecStart=/opt/1panel/docker/compose/learnhouse/docker/verify-rag.sh
UMask=0077
Nice=10
TimeoutStartSec=10m
