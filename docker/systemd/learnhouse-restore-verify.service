[Unit]
Description=Verify the latest LearnHouse backup by isolated restore
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=root
Group=root
Environment="PATH=/root/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin"
Environment="LEARNHOUSE_BACKUP_OUTPUT_DIR=/var/backups/learnhouse"
Environment="LEARNHOUSE_RESTORE_REPORT=/var/lib/learnhouse/backup-verification/latest.json"
WorkingDirectory=/opt/1panel/docker/compose/learnhouse
EnvironmentFile=-/etc/learnhouse/backup.env
ExecStart=/opt/1panel/docker/compose/learnhouse/docker/verify-backup.sh --latest-from ${LEARNHOUSE_BACKUP_OUTPUT_DIR} --report ${LEARNHOUSE_RESTORE_REPORT}
UMask=0077
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TimeoutStartSec=2h
