# Install as /etc/learnhouse/rag-verify.env with mode 0600.
# The report contains only aggregate health data and should remain private.
LEARNHOUSE_RAG_VERIFY_REPORT=/var/lib/learnhouse/rag-verification/latest.json

# Optional executable invoked only on failure as:
#   hook rag_verify_failed /path/to/latest.json
# Use a root-owned absolute path. The script never evaluates shell fragments.
LEARNHOUSE_RAG_VERIFY_ALERT_HOOK=
