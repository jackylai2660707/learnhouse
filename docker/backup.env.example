# LearnHouse 每日備份設定。不要在此檔案直接保存雲端 access key。
LEARNHOUSE_BACKUP_OUTPUT_DIR=/var/backups/learnhouse
LEARNHOUSE_BACKUP_RETENTION_DAYS=30
LEARNHOUSE_BACKUP_MINIMUM_BACKUPS=7
LEARNHOUSE_BACKUP_MAX_AGE_HOURS=36
LEARNHOUSE_BACKUP_REDIS_MODE=required

# Hook 必須是 root 擁有、可執行的絕對路徑；runner 會把完成的備份目錄
# 作為唯一參數傳入。Hook 內部從自己的 0600 設定檔讀取遠端憑證。
# LEARNHOUSE_BACKUP_OFFSITE_HOOK=/usr/local/sbin/learnhouse-offsite-upload

# 失敗時執行，不帶命令列秘密。錯誤碼放在 LEARNHOUSE_OPERATION_CODE。
# LEARNHOUSE_BACKUP_ALERT_HOOK=/usr/local/sbin/learnhouse-operations-alert
# LEARNHOUSE_RESTORE_ALERT_HOOK=/usr/local/sbin/learnhouse-operations-alert

# 每月 restore verifier 使用的隔離 PostgreSQL image 和 tmpfs 上限。
LEARNHOUSE_RESTORE_VERIFY_IMAGE=pgvector/pgvector:pg16
LEARNHOUSE_RESTORE_VERIFY_TMPFS_SIZE_MB=4096
